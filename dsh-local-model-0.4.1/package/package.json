{
  "name": "dsh-local-model",
  "version": "0.4.1",
  "description": "DSH plugin: use local GGUF model files through llama.cpp, or any OpenAI-compatible local server, as first-class DSH model providers.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "CHANGELOG.md",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "llama.cpp",
    "gguf",
    "local-model",
    "offline",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "verify": "node scripts/verify-runtime.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "license": "MIT"
}
